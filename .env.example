NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_aqui_a_chave_anon_public

# Só usada no servidor (rota de criar usuário) — NUNCA leva o prefixo
# NEXT_PUBLIC_, pra nunca ser enviada ao navegador. Pegue em Project
# Settings -> API -> service_role no Supabase.
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_chave_service_role

# Conta de serviço do Google (pra salvar as fotos no Google Drive da
# equipe). Veja o passo a passo em GUIA-GOOGLE-DRIVE.md.
GOOGLE_SERVICE_ACCOUNT_EMAIL=algo@seu-projeto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=1G9N4SzVROQ4clrhTac5pZFgNBN9jOIY4

# Chave da IA (Google Gemini) que identifica o tipo do item pela foto e
# sugere a descrição sozinha. Opcional — sem ela o site funciona normal,
# só não sugere a descrição. Veja o passo a passo em
# GUIA-IDENTIFICACAO-FOTO.md.
GEMINI_API_KEY=cole_aqui_a_chave_do_google_ai_studio
